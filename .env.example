

# SMTP settings for product notifications.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="false"
MAIL_FROM="KOMSE DESIGN <no-reply@example.com>"
ADMIN_EMAIL="admin@example.com"
MAIL_PORT="3001"
SERVER_PORT="3001"
VITE_PORT="3000"
VITE_API_URL=
FRONTEND_URL=
NODE_ENV=production

# Stripe hosted Checkout settings.
STRIPE_SECRET_KEY=
APP_URL=http://localhost:3000

# Frontend-safe Supabase project configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase admin access. Never expose this as VITE_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
