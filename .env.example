MAIL_PORT="3001"
SERVER_PORT="3001"
VITE_PORT="3000"
VITE_API_URL="https://your-api.example.com"
VITE_SUPABASE_FUNCTIONS_URL="https://your-project.supabase.co/functions/v1"
